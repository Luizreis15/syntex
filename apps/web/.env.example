# Obrigatórias na Vercel (Settings → Environment Variables).
# Preferir o projeto syntex-dev até haver projeto de produção separado.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-api-key

# Gateway Asaas (Lote 5). Deixe vazio para usar stub.
ASAAS_API_KEY=
ASAAS_SANDBOX=true
ASAAS_WEBHOOK_TOKEN=

# Itaú: só via itau-bridge-veramo (Railway). Sem REAL=true → mock.
# Syntex não usa mTLS nem chama a API Itaú direto.
ITAU_REAL_CHARGE_ENABLED=false
BRIDGE_URL=                 # https://<itau-bridge-veramo>.up.railway.app
BRIDGE_ACCESS_TOKEN=
ITAU_WEBHOOK_TOKEN=
